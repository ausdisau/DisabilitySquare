generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IdentityType {
  PASSWORD
  MAGIC_LINK
  OIDC
  PASSKEY
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MfaMethod {
  TOTP
  WEBAUTHN
  BACKUP_CODE
}

enum AuditActorType {
  USER
  SYSTEM
  ADMIN
}

model User {
  id                    String                    @id @default(cuid())
  externalSubject       String?                   @unique
  email                 String                    @unique
  emailNormalized       String                    @unique
  emailVerified         Boolean                   @default(false)
  displayName           String?
  givenName             String?
  familyName            String?
  avatarUrl             String?
  locale                String?
  timezone              String?
  isActive              Boolean                   @default(true)
  isLocked              Boolean                   @default(false)
  lockedReason          String?
  lastLoginAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  deletedAt             DateTime?
  identities            Identity[]
  sessions              Session[]
  mfaEnrollments        MfaEnrollment[]
  accessibilityPrefs    AccessibilityPreference[]
  roleAssignments       UserRole[]
  consents              ConsentRecord[]
  auditEvents           AuditEvent[]              @relation("AuditActor")
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Identity {
  id                  String        @id @default(cuid())
  userId              String
  type                IdentityType
  provider            String?
  providerSubject     String?
  passwordHash        String?
  passwordVersion     Int?
  passwordUpdatedAt   DateTime?
  isPrimary           Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  lastUsedAt          DateTime?
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, type])
}

model Session {
  id                String        @id @default(cuid())
  userId            String
  tokenHash         String        @unique
  refreshTokenHash  String?       @unique
  status            SessionStatus @default(ACTIVE)
  ipAddress         String?
  userAgent         String?
  deviceName        String?
  lastSeenAt        DateTime?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model MfaEnrollment {
  id                String      @id @default(cuid())
  userId            String
  method            MfaMethod
  label             String?
  secretEncrypted   String?
  credentialId      String?
  publicKey         String?
  counter           Int?
  isPrimary         Boolean     @default(false)
  isVerified        Boolean     @default(false)
  createdAt         DateTime    @default(now())
  verifiedAt        DateTime?
  lastUsedAt        DateTime?
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, method])
}

model AccessibilityPreference {
  id                      String    @id @default(cuid())
  userId                  String
  textScale               Int?      @default(100)
  contrastMode            String?
  reducedMotion           Boolean?  @default(false)
  easyRead                Boolean?  @default(false)
  captionsPreferred       Boolean?  @default(false)
  transcriptsPreferred    Boolean?  @default(false)
  simplifiedLayout        Boolean?  @default(false)
  screenReaderOptimized   Boolean?  @default(false)
  keyboardOnly            Boolean?  @default(false)
  colorTheme              String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model Role {
  id            String     @id @default(cuid())
  key           String     @unique
  name          String
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  assignments   UserRole[]
}

model UserRole {
  id            String    @id @default(cuid())
  userId        String
  roleId        String
  scope         String?   @default("global")
  grantedBy     String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scope])
  @@index([roleId])
}

model ConsentRecord {
  id              String    @id @default(cuid())
  userId          String
  consentType     String
  granted         Boolean
  version         String?
  recordedAt      DateTime  @default(now())
  ipAddress       String?
  userAgent       String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

model AuditEvent {
  id              String          @id @default(cuid())
  actorUserId     String?
  actorType       AuditActorType
  eventType       String
  targetUserId    String?
  targetType      String?
  metadataJson    Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime        @default(now())
  actor           User?           @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([eventType])
  @@index([createdAt])
}

model PasswordResetToken {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
