# Neon pooled connection for runtime / Prisma Client
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon direct connection for Prisma CLI and migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# Optional extra secret used by your auth service
AUTH_PEPPER="replace-with-a-long-random-secret"
